FROM node:lts-alpine AS frontend-build

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ .

ARG VITE_BASE_PATH=/
ENV VITE_BASE_PATH=$VITE_BASE_PATH

RUN npm run build && cp -r src/assets/. dist/assets/

FROM nginx:alpine

RUN apk add --no-cache gettext

COPY nginx/nginx.conf /etc/nginx/nginx.conf
COPY nginx/sites/dev.conf.template /etc/nginx/sites/dev.conf.template
COPY nginx/sites/prod.conf.template /etc/nginx/sites/prod.conf.template
COPY nginx/sites/prod.http.conf.template /etc/nginx/sites/prod.http.conf.template
COPY nginx/entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh \
    && mkdir -p /etc/nginx/conf.d

COPY --from=frontend-build /app/dist /usr/share/nginx/html/frontend

ENTRYPOINT ["/entrypoint.sh"]
