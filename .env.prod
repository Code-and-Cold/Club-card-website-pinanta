# Frontend (prod — статическая сборка в nginx)
VITE_BASE_PATH=/

# Backend
BACKEND_INTERNAL_PORT=8080

YANDEX_API_BASE="https://cloud-api.yandex.net/v1/disk/resources"
YANDEX_DISK_TOKEN=""
YANDEX_TABLE_PATH=""

BACKEND_ADMIN_LOGIN=admin
BACKEND_ADMIN_PASSWORD=admin123

# DB
POSTGRES_USER=clubuser
POSTGRES_PASSWORD=clubpass
POSTGRES_DB=clubdb
POSTGRES_INTERNAL_PORT=5432

# Nginx / домен
DOMAIN=cold-code.ru
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# off — HTTP без сертификата (проверка до настройки DNS)
# on  — HTTPS после ./nginx/scripts/ssl-setup.sh
NGINX_SSL=off

# E-mail для Let's Encrypt (нужен при NGINX_SSL=on)
SSL_EMAIL=admin@cold-code.ru
